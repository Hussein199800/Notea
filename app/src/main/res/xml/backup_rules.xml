<?xml version="1.0" encoding="utf-8"?>
<!-- Android auto-backup (API <= 30). The vault key is wrapped by this device's Keystore and is
     useless elsewhere, so it is excluded; locked notes are restored via the vault passphrase. -->
<full-backup-content>
    <exclude domain="sharedpref" path="notea_vault.xml" />
    <exclude domain="sharedpref" path="notea_ai.xml" />
    <exclude domain="file" path="backups/" />
</full-backup-content>
